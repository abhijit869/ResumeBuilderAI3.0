# ============================================================================
# ResumeBuilderAi 3.0 — Environment & Installation Requirements (.env.example)
# ============================================================================
#
# 1. SYSTEM PREREQUISITES
#    - Node.js 24.x (see .node-version)
#    - npm >= 10.x or bun >= 1.1.x
#    - Next.js 15.4+ (App Router, React 19, TypeScript 5.9, Tailwind CSS v4)
#
# 2. INSTALLATION & SETUP COMMANDS
#    - Install dependencies:
#        npm install
#    - Copy environment template:
#        cp .env.example .env.local
#    - Run unit, utility, white-box & security/vulnerability tests:
#        npm test
#    - Run ESLint static analysis:
#        npm run lint
#    - Start development server (Port 3000):
#        npm run dev
#    - Build production bundle:
#        npm run build
#    - Start production server:
#        npm run start
#
# ============================================================================
# 3. REQUIRED & OPTIONAL ENVIRONMENT VARIABLES
# ============================================================================

# GEMINI_API_KEY: Required for server-side Gemini AI API calls (/api/ai/resume).
# AI Studio automatically injects this at runtime from user secrets.
# Security Note: Server-only secret. NEVER prefix with NEXT_PUBLIC_.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The canonical URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and portfolio share endpoints.
APP_URL="http://localhost:3000"

# ----------------------------------------------------------------------------
# AUTO-CONFIGURED RUNTIME FLAGS (Pre-filled in next.config.ts — No manual Secret input needed)
# ----------------------------------------------------------------------------
# NEXT_PUBLIC_FIREBASE_EMAIL_AUTH_ENABLED: Valid values are "false" (default) or "true".
#   - Auto-filled default: "false" (uses Google OAuth + PBKDF2-SHA256 local auth fallback;
#     if set to "true", attempts Firebase Email/Password auth first with automatic fallback).
# DISABLE_HMR: Valid values are "true" (default in AI Studio) or "false" (local dev).
#   - Auto-filled default: "true" in AI Studio preview container to prevent iframe reload flicker.

# ============================================================================
# 4. MONGODB ATLAS CLOUD DATABASE CONFIGURATION
# ============================================================================
# Official Cloud MongoDB Atlas Connection URI:
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.0079pe2.mongodb.net/resumebuilderai_db?retryWrites=true&w=majority&appName=Cluster0"
MONGODB_DB_NAME="resumebuilderai_db"


# Render supplies PORT and RENDER_EXTERNAL_URL automatically.
# APP_URL overrides RENDER_EXTERNAL_URL; set it to your custom domain if needed.
# Enable Firebase Email/Password in the Firebase console before setting this true.
NEXT_PUBLIC_FIREBASE_EMAIL_AUTH_ENABLED="true"
# Optional: a server API key for the SAME Firebase project, if the browser key
# is HTTP-referrer restricted. Restrict this key to Identity Toolkit API.
# FIREBASE_AUTH_API_KEY=""
# Optional Firebase project overrides (set before building):
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
# NEXT_PUBLIC_FIREBASE_APP_ID=""
# NEXT_PUBLIC_FIREBASE_API_KEY=""
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
# NEXT_PUBLIC_FIREBASE_DATABASE_ID="(default)"
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
# NEXT_PUBLIC_FIREBASE_OAUTH_CLIENT_ID=""
