# ============================================================================
# ResumeBuilderAi 3.0 — Environment & Installation Requirements (.env.example)
# ============================================================================
#
# 1. SYSTEM PREREQUISITES
#    - Node.js >= 20.x LTS (recommended: v20.11+ or v22.x)
#    - npm >= 10.x or bun >= 1.1.x
#    - Next.js 15.4+ (App Router, React 19, TypeScript 5.9, Tailwind CSS v4)
#
# 2. INSTALLATION & SETUP COMMANDS
#    - Install dependencies:
#        npm install
#    - Copy environment template:
#        cp .env.example .env.local
#    - Run unit, utility, white-box & security/vulnerability tests:
#        npx --yes tsx --test lib/ai-bullet-rewriter.test.ts lib/resume-engine.test.ts lib/security-utils.test.ts
#    - Run ESLint static analysis:
#        npm run lint
#    - Start development server (Port 3000):
#        npm run dev
#    - Build production bundle:
#        npm run build
#    - Start production server:
#        npm run start
#
# ============================================================================
# 3. REQUIRED & OPTIONAL ENVIRONMENT VARIABLES
# ============================================================================

# GEMINI_API_KEY: Required for server-side Gemini AI API calls (/api/ai/resume).
# AI Studio automatically injects this at runtime from user secrets.
# Security Note: Server-only secret. NEVER prefix with NEXT_PUBLIC_.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The canonical URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and portfolio share endpoints.
APP_URL="http://localhost:3000"

# ----------------------------------------------------------------------------
# AUTO-CONFIGURED RUNTIME FLAGS (Pre-filled in next.config.ts — No manual Secret input needed)
# ----------------------------------------------------------------------------
# NEXT_PUBLIC_FIREBASE_EMAIL_AUTH_ENABLED: Valid values are "false" (default) or "true".
#   - Auto-filled default: "false" (uses Google OAuth + PBKDF2-SHA256 local auth fallback;
#     if set to "true", attempts Firebase Email/Password auth first with automatic fallback).
# DISABLE_HMR: Valid values are "true" (default in AI Studio) or "false" (local dev).
#   - Auto-filled default: "true" in AI Studio preview container to prevent iframe reload flicker.

