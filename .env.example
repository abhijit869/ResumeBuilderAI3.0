# ============================================================================
# ResumeGPT — required environment variables
# Copy to .env (root) or set in your Replit Secrets / hosting provider.
# This file is a TEMPLATE — never put real secrets here (it is committed to git).
# ============================================================================

# --- Database (REQUIRED — server and drizzle both crash without it) ---
# PostgreSQL connection string
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# --- Clerk auth (REQUIRED — Clerk is the only auth provider) ---
# Backend secret key (server-side; Clerk dashboard -> API Keys -> Secret key)
CLERK_SECRET_KEY=sk_test_replace_me
# Publishable key (server-side middleware + frontend build)
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Frontend-only copy of the publishable key (Vite injects this at build time)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Frontend Clerk proxy URL (needed when Clerk is fronted through your domain)
VITE_CLERK_PROXY_URL=https://your-app.example.com/__clerk

# --- OpenCode Zen AI (REQUIRED for resume generation) ---
OPENCODEZEN_API_KEY=replace_me
# Optional; defaults to https://opencode.ai/zen/v1 (already set in .replit)
# OPENCODEZEN_BASE_URL=https://opencode.ai/zen/v1

# --- LinkedIn OAuth (REQUIRED for "Continue with LinkedIn" import) ---
# Create a LinkedIn developer app at https://www.linkedin.com/developers/apps
# (Products: "Sign In with LinkedIn using OpenID Connect").
# Register the redirect URI: http://localhost:8080/api/auth/linkedin/callback
# (or your deployed origin + /api/auth/linkedin/callback).
LINKEDIN_CLIENT_ID=replace_me
LINKEDIN_CLIENT_SECRET=replace_me
# Optional; derived from the request host when omitted:
# LINKEDIN_REDIRECT_URI=http://localhost:8080/api/auth/linkedin/callback

# --- Runtime (non-secret, usually set by the host / .replit) ---
PORT=8080
BASE_PATH=/
NODE_ENV=development
LOG_LEVEL=info
